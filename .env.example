# Neon PostgreSQL
DATABASE_URL=

# OpenRouter (GPT-4o mini)
OPENROUTER_API_KEY=

# Facebook webhook verification (must match Meta app config)
VERIFY_TOKEN=

# Meta app secret — enables X-Hub-Signature-256 verification on webhooks
APP_SECRET=

# AES-256-CBC key for encrypting page access tokens (64 hex chars)
TOKEN_SECRET=

# Better Auth session signing secret (64 hex chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Dashboard origin (CORS)
DASHBOARD_URL=http://localhost:3001

# Facebook Graph API version
GRAPH_API_VERSION=v23.0

# bKash tokenized checkout (production: https://tokenized.pay.bka.sh/v1.2.0-beta)
BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=http://localhost:3001/credits/callback
